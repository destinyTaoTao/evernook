{
  "name": "@evernook/harnesses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin trusted native harness adapters for the same EverNook ledger",
  "engines": { "node": ">=24.11.0 <25" },
  "exports": { "./dsh": "./dist/dsh.js", "./client": "./dist/client.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=120000 test/*.test.ts"
